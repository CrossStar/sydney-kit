#!/bin/sh
# Register this machine's Windows CJK font for WSL SVG rasterization.
# The font stays on Windows; no font files are bundled or redistributed.
set -eu
font=/mnt/c/Windows/Fonts/msyh.ttc
[ -r "$font" ] || { echo 'Windows Microsoft YaHei not found. Install a CJK font such as fonts-noto-cjk in Linux.' >&2; exit 1; }
command -v fc-cache >/dev/null 2>&1 || { echo 'fontconfig (fc-cache) is required.' >&2; exit 1; }
font_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/sydney-kit"
mkdir -p "$font_dir"
if [ ! -e "$font_dir/msyh.ttc" ] && [ ! -L "$font_dir/msyh.ttc" ]; then
  ln -s "$font" "$font_dir/msyh.ttc"
fi
fc-cache -f "$font_dir"
fc-match 'sans-serif:lang=zh-cn'
echo 'Restart Pi after font registration; clear the LaTeX cache if it contains missing-glyph images.'
