#!/bin/sh
# Run in Linux/WSL, directly in Tern or inside Zellij. Preserve the caller's cwd.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
kit_dir=$(dirname -- "$script_dir")
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
command -v node >/dev/null 2>&1 || { echo 'pi-tern: Node.js is required' >&2; exit 1; }
# Zellij handles the inner pane geometry. Querying Tern TSP here cannot reach
# the outer terminal; use zellij-tern when starting Zellij for outer geometry.
if [ -n "${ZELLIJ:-}" ] || [ -n "${ZELLIJ_SESSION_NAME:-}" ]; then
  exec node "$script_dir/math-host.mjs" \
    "$kit_dir/node_modules/@earendil-works" "$kit_dir/.pi/math-host" \
    -e "$kit_dir/index.ts" "$@"
fi
command -v python3 >/dev/null 2>&1 || { echo 'pi-tern: python3 is required' >&2; exit 1; }
# Patch a project-local host only; never modify the globally installed Pi.
exec python3 "$script_dir/tern-geometry.py" -- node "$script_dir/math-host.mjs" \
  "$kit_dir/node_modules/@earendil-works" "$kit_dir/.pi/math-host" \
  -e "$kit_dir/index.ts" "$@"
