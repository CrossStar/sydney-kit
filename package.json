{
  "name": "sydney-kit",
  "version": "0.1.0",
  "description": "Compact tools, code highlighting, diffs and image paste for Pi Coding Agent",
  "repository": { "type": "git", "url": "https://github.com/CrossStar/sydney-kit.git" },
  "homepage": "https://github.com/CrossStar/sydney-kit#readme",
  "bugs": { "url": "https://github.com/CrossStar/sydney-kit/issues" },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs",
    "patch:status": "node patches/apply.mjs status && node patches/tern-images.mjs status && node patches/compaction-card.mjs status"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/tokyo-night.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@shikijs/cli": "4.5.0",
    "diff": "9.0.0",
    "shiki": "4.5.0"
  }
}
